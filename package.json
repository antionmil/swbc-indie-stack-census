{
  "name": "indie-stack-census",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "census": "tsx --conditions=react-server scripts/census.mts",
    "qa": "tsx scripts/contrast.mts && tsx --conditions=react-server qa/diff.test.mts && tsx qa/rules.test.mts",
    "qa:cron": "tsx qa/cron.test.mts",
    "db:push": "drizzle-kit push",
    "db:gen": "drizzle-kit generate",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "qa:diff": "tsx --conditions=react-server qa/diff.test.mts",
    "list:build": "tsx scripts/build-list.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.44.6",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
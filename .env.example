# Neon, Frankfurt — the same region as the Vercel functions (vercel.json pins
# fra1). A US database behind EU functions puts a transatlantic hop on every
# query, and this one runs 51 inserts in a batch.
DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Protects /api/cron/*. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Tested by firing at it: pnpm qa:cron <url>
CRON_SECRET=

# Used for canonical URLs, the sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://stackcensus.onedaybuilt.com
